<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXUS 2026 // 3D Interactive Techfest</title>
    <style>
        @import url('https://googleapis.com');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #030308;
            color: #ffffff;
            font-family: 'Rajdhani', sans-serif;
            overflow-x: hidden;
        }

        /* Fixed 3D Canvas Background */
        #webgl-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            outline: none;
        }

        /* Navigation Bar */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 25px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: linear-gradient(to bottom, rgba(3,3,8,0.8), transparent);
        }

        .logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: 3px;
            color: #00f3ff;
            text-shadow: 0 0 15px rgba(0, 243, 255, 0.6);
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            margin-left: 30px;
            font-size: 1.1rem;
            font-weight: 500;
            letter-spacing: 1px;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: #ff007f;
        }

        /* Scrollable Sections */
        section {
            min-height: 100vh;
            padding: 0 10%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        /* Hero Section */
        .hero {
            align-items: flex-start;
        }

        .hero h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 5rem;
            font-weight: 900;
            line-height: 1.1;
            text-transform: uppercase;
            background: linear-gradient(90deg, #ffffff, #00f3ff, #ff007f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 1.4rem;
            max-width: 600px;
            color: #b0b8d1;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .btn {
            padding: 15px 40px;
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: #030308;
            background: #00f3ff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.5);
            transition: all 0.3s ease;
        }

        .btn:hover {
            background: #ff007f;
            color: #fff;
            box-shadow: 0 0 30px rgba(255, 0, 127, 0.8);
            transform: translateY(-3px);
        }

        /* Glassmorphism Cards for Events */
        .section-right {
            align-items: flex-end;
            text-align: right;
        }

        .glass-card {
            background: rgba(15, 20, 40, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 243, 255, 0.25);
            border-radius: 16px;
            padding: 40px;
            max-width: 550px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
            opacity: 0;
            transform: translateY(50px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .glass-card h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            color: #00f3ff;
            margin-bottom: 15px;
        }

        .glass-card p {
            font-size: 1.2rem;
            color: #d0d7ee;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .tag {
            display: inline-block;
            padding: 5px 15px;
            background: rgba(255, 0, 127, 0.2);
            border: 1px solid #ff007f;
            color: #ff007f;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        /* Interactive Hint */
        .hint {
            position: fixed;
            bottom: 25px;
            right: 40px;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.5);
            letter-spacing: 1px;
            pointer-events: none;
        }

        @media (max-width: 768px) {
            .hero h1 { font-size: 3rem; }
            nav { padding: 20px; }
            .nav-links { display: none; }
        }
    </style>
</head>
<body>

    <!-- 3D WebGL Canvas -->
    <canvas id="webgl-canvas"></canvas>

    <!-- Navigation -->
    <nav>
        <div class="logo">NEXUS // 26</div>
        <div class="nav-links">
            <a href="#home">CORE</a>
            <a href="#hackathon">HACKATHON</a>
            <a href="#robotics">ROBOTICS</a>
            <a href="#register">REGISTER</a>
        </div>
    </nav>

    <!-- Section 1: Hero -->
    <section id="home" class="hero">
        <div class="tag">ANNUAL TECHFEST • NOV 2026</div>
        <h1>Beyond The<br>Singularity</h1>
        <p>Experience the next evolution of technology, AI, and cybernetics. Scroll to explore the Quantum Core or click the 3D artifact to trigger an energy surge.</p>
        <button class="btn" onclick="document.getElementById('register').scrollIntoView({behavior: 'smooth'})">Enter The Grid</button>
    </section>

    <!-- Section 2: Hackathon -->
    <section id="hackathon" class="section-right">
        <div class="glass-card">
            <div class="tag">48-HOUR CODING MARATHON</div>
            <h2>QUANTUM HACK</h2>
            <p>Push the boundaries of generative AI, Web3, and spatial computing. Build real-world solutions alongside 2,000+ elite developers and compete for a $50,000 prize pool.</p>
            <button class="btn">View Tracks</button>
        </div>
    </section>

    <!-- Section 3: Robotics -->
    <section id="robotics">
        <div class="glass-card">
            <div class="tag">AUTONOMOUS COMBAT</div>
            <h2>MECHA ARENA</h2>
            <p>Witness heavy-metal engineering clash in high-voltage combat. From autonomous drone swarms to 60kg battlebots, only the strongest algorithms survive.</p>
            <button class="btn">Arena Rules</button>
        </div>
    </section>

    <!-- Section 4: Registration -->
    <section id="register" class="section-right">
        <div class="glass-card">
            <div class="tag">LIMITED ACCESS PASSES</div>
            <h2>CLAIM YOUR PASS</h2>
            <p>Secure your entry to workshops, keynotes from industry pioneers, and midnight cyber-concerts. Registrations close soon.</p>
            <button class="btn" onclick="alert('Registration Portal Initialized! Welcome to NEXUS 2026.')">Register Now</button>
        </div>
    </section>

    <div class="hint">[ MOVE MOUSE TO ORBIT • CLICK CORE TO PULSE • SCROLL TO DIVE ]</div>

    <!-- Three.js CDN -->
    <script src="https://cloudflare.com"></script>

    <script>
        // 1. SCENE SETUP
        const canvas = document.querySelector('#webgl-canvas');
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x030308, 0.035);

        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 8;

        const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // 2. 3D OBJECTS (THE QUANTUM CORE)
        const coreGroup = new THREE.Group();
        scene.add(coreGroup);

        // Inner Glowing Icosahedron
        const geoCore = new THREE.IcosahedronGeometry(1.8, 1);
        const matCore = new THREE.MeshStandardMaterial({
            color: 0x00f3ff,
            wireframe: true,
            emissive: 0x00f3ff,
            emissiveIntensity: 0.6
        });
        const coreMesh = new THREE.Mesh(geoCore, matCore);
        coreGroup.add(coreMesh);

        // Solid Inner Nucleus
        const geoNucleus = new THREE.OctahedronGeometry(1.0, 0);
        const matNucleus = new THREE.MeshStandardMaterial({
            color: 0xff007f,
            roughness: 0.2,
            metalness: 0.8,
            emissive: 0xff007f,
            emissiveIntensity: 0.4
        });
        const nucleusMesh = new THREE.Mesh(geoNucleus, matNucleus);
        coreGroup.add(nucleusMesh);

        // Orbiting Gyroscope Rings
        const ringGeo1 = new THREE.TorusGeometry(2.8, 0.03, 16, 100);
        const ringMat1 = new THREE.MeshBasicMaterial({ color: 0x00f3ff });
        const ring1 = new THREE.Mesh(ringGeo1, ringMat1);
        coreGroup.add(ring1);

        const ringGeo2 = new THREE.TorusGeometry(3.5, 0.02, 16, 100);
        const ringMat2 = new THREE.MeshBasicMaterial({ color: 0xff007f });
        const ring2 = new THREE.Mesh(ringGeo2, ringMat2);
        ring2.rotation.x = Math.PI / 3;
        coreGroup.add(ring2);

        // Floating Data Particles (Starfield)